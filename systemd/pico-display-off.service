# pico-display-off.service
#
# Oneshot service that powers off the display.
# Triggered by pico-display-off.timer on schedule.
# Can also be triggered manually: systemctl --user start pico-display-off
#
# Installed by: scripts/kiosk-setup.sh
# Destination:  ~/.config/systemd/user/pico-display-off.service

[Unit]
Description=PicoGallery — turn display off

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pico-display-power off
