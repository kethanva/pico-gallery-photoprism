# pico-kiosk.service
#
# Launches the PicoGallery kiosk browser (cog via cage, or chromium).
# The browser is chosen and the ExecStart line is written by kiosk-setup.sh
# at install time — this file is the template / reference copy.
#
# Key design decisions:
#   • Restart=always — essential for 24/7 kiosks where the browser may crash
#     after days of running or after a network drop.
#   • Requires=pico-wait-online.service — do not open the browser until
#     the server is reachable (prevents frozen "Network Error" page).
#   • XDG_RUNTIME_DIR — required for Wayland (cage/cog) to find the socket.
#   • WPE_BACKEND=fdo — enables hardware-accelerated DRM/KMS rendering via
#     the WPE FDO backend. Without this, cog falls back to software rendering
#     (extremely slow on a Pi Zero).
#
# Installed by: scripts/kiosk-setup.sh
# Destination:  ~/.config/systemd/user/pico-kiosk.service
#
# Logs:  journalctl --user -u pico-kiosk -f
# Restart manually:  systemctl --user restart pico-kiosk

[Unit]
Description=PicoGallery Kiosk Browser
Documentation=https://github.com/your-org/pico-gallery-photoprism
After=pico-wait-online.service graphical-session.target
Requires=pico-wait-online.service
PartOf=graphical-session.target

[Service]
# Load kiosk environment (PICO_SERVER_URL etc.)
EnvironmentFile=%h/.config/picogallery/kiosk.env

# Wayland compositor needs this to find the socket
Environment=XDG_RUNTIME_DIR=/run/user/%U

# ── WPE/cog hardware acceleration ───────────────────────────────────────────
# WPE_BACKEND=fdo: use Wayland/KMS via libwpe-backend-fdo.
# GST_VAAPI_ALL_DRIVERS=1: allow GStreamer to use any VAAPI driver for HW
# video decode (thumbnails, video sources).
# Without WPE_BACKEND the browser falls back to software rendering.
Environment=WPE_BACKEND=fdo
Environment=GST_VAAPI_ALL_DRIVERS=1

# Restart on any failure — the watchdog for a 24/7 kiosk.
# RestartSec prevents a crash-loop hammering the CPU.
Restart=always
RestartSec=5s

# ── ExecStart ───────────────────────────────────────────────────────────────
# For cog (Pi Zero — WPE WebKit via Cage):
#   ExecStart=/bin/bash -c 'exec cage -d -- cog --bg-color=000000 "$PICO_SERVER_URL"'
#
# For chromium (Pi Zero 2 W / Pi 4):
#   ExecStart=/bin/bash -c 'exec chromium-browser --kiosk --app="$PICO_SERVER_URL" \
#     --disable-infobars --disable-session-crashed-bubble \
#     --disable-features=TranslateUI,Translate \
#     --overscroll-history-navigation=0 --noerrdialogs \
#     --autoplay-policy=no-user-gesture-required'
#
# kiosk-setup.sh writes the correct line for your hardware.
# If editing manually, uncomment one of the lines above.
#
ExecStart=/bin/bash -c 'exec cage -d -- cog --bg-color=000000 "$PICO_SERVER_URL"'

KillMode=process

[Install]
WantedBy=graphical-session.target
