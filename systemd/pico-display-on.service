# pico-display-on.service
#
# Oneshot service that powers on the display.
# Triggered by pico-display-on.timer on schedule.
# Can also be triggered manually: systemctl --user start pico-display-on
#
# Installed by: scripts/kiosk-setup.sh
# Destination:  ~/.config/systemd/user/pico-display-on.service

[Unit]
Description=PicoGallery — turn display on

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pico-display-power on
