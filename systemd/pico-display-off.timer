# pico-display-off.timer
#
# Daily calendar timer that fires pico-display-off.service.
# Edit OnCalendar to change the blank time (default: 22:00 local time).
#
# Installed by: scripts/kiosk-setup.sh
# Destination:  ~/.config/systemd/user/pico-display-off.timer

[Unit]
Description=PicoGallery — blank display at 22:00

[Timer]
OnCalendar=*-*-* 22:00:00
Persistent=true

[Install]
WantedBy=timers.target
