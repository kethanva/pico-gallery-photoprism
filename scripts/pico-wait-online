#!/usr/bin/env bash
#
# pico-wait-online — block until the PicoGallery server responds HTTP 200.
#
# This solves a critical boot race condition: systemd may start the kiosk
# service before Wi-Fi has associated, an IP address has been obtained via
# DHCP, or the remote PicoGallery server has finished starting up.
#
# Without this guard, WPE/cog or Chromium will open a "Network Error" page
# and sit there, frozen, even after the network comes up — because neither
# browser auto-retries a failed initial URL load.
#
# Usage:
#   pico-wait-online <server-url> [max-wait-seconds]
#
# Examples:
#   pico-wait-online http://192.168.1.10:8188 120
#   pico-wait-online http://picogallery.local:8188
#
# Exit codes:
#   0 — server responded HTTP 200 (or timeout expired — browser launches anyway)
#   1 — bad arguments
#
# Copied to /usr/local/bin/ by kiosk-setup.sh.

set -euo pipefail

URL_BASE="${1:?Usage: pico-wait-online <server-url> [max-wait-seconds]}"
MAX="${2:-120}"
INTERVAL=3
WAITED=0

# Normalise: strip trailing slash, append health path
HEALTH_URL="${URL_BASE%/}/api/health"

echo "[pico-wait-online] Waiting for: ${HEALTH_URL}"
echo "[pico-wait-online] Timeout: ${MAX}s"

while true; do
  HTTP_STATUS=$(
    curl -fsSo /dev/null \
         -w '%{http_code}' \
         --max-time 5 \
         "${HEALTH_URL}" 2>/dev/null || true
  )

  if [[ "$HTTP_STATUS" == "200" ]]; then
    echo "[pico-wait-online] ✓ Server ready (HTTP 200) after ${WAITED}s — launching browser."
    exit 0
  fi

  if [[ $WAITED -ge $MAX ]]; then
    echo "[pico-wait-online] ✗ TIMEOUT: server did not respond within ${MAX}s."
    echo "[pico-wait-online]   Last status: HTTP ${HTTP_STATUS:-no response}"
    echo "[pico-wait-online]   Launching browser anyway — it will show an error page."
    echo "[pico-wait-online]   The kiosk.service Restart=always policy will retry on crash."
    exit 0   # Exit 0 so the dependent browser service still starts
  fi

  echo "[pico-wait-online] HTTP ${HTTP_STATUS:-no response} — retry in ${INTERVAL}s  (${WAITED}/${MAX}s elapsed)"
  sleep "$INTERVAL"
  WAITED=$(( WAITED + INTERVAL ))
done
