{
  "compact": false,
  "presets": [
    [
      "@babel/preset-env",
      {
        "//": "useBuiltIns:usage injects ONLY the core-js polyfills each transpiled file actually needs for the browserslist target, instead of app.js eagerly importing the whole core-js/stable + regenerator-runtime (~100-150 KB) on every browser. The frame runs modern WPE WebKit, so almost nothing is injected — smaller boot bundle, less parse on the Pi Zero 2 W. corejs pinned to the installed 3.49 so the polyfill list matches the library.",
        "useBuiltIns": "usage",
        "corejs": "3.49"
      }
    ]
  ],
  "plugins": []
}
