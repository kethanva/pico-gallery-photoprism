# PicoGallery kiosk — limited sudo for the kiosk user.
# Installed to /etc/sudoers.d/picogallery-kiosk (mode 0440) by install.sh.
#
# Lets the appliance restart its own kiosk and reboot/power off without a
# password (handy for a remote "restart frame" control), but nothing else.
# Keep this list tight — it is the kiosk's entire privileged surface.

Cmnd_Alias PICO_KIOSK = \
    /usr/bin/systemctl restart picogallery-kiosk.service, \
    /usr/bin/systemctl stop picogallery-kiosk.service, \
    /usr/bin/systemctl start picogallery-kiosk.service, \
    /usr/bin/systemctl restart picogallery.service, \
    /sbin/reboot, \
    /sbin/poweroff

picokiosk ALL=(root) NOPASSWD: PICO_KIOSK
