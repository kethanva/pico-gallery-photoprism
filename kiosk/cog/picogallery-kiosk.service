[Unit]
Description=PicoGallery kiosk (Cog/WPE WebKit under Cage)
Documentation=https://github.com/your-org/picogallery
After=network-online.target seatd.service getty@tty1.service
Wants=network-online.target seatd.service
# Cage needs tty1 + the DRM master; the distro's console (DietPi/getty) owns them.
# Conflicts stops getty@tty1 whenever the kiosk starts so the two never fight over
# the VT (a fight that otherwise grabs the physical keyboard in a restart loop).
Conflicts=getty@tty1.service
# If the kiosk can't render, give up after a few quick tries instead of looping
# forever — a forever-loop repeatedly seizes the keyboard and locks out the console.
StartLimitIntervalSec=120
StartLimitBurst=5
# When the kiosk finally gives up (start-limit hit → 'failed'), bring the tty1
# login back so the device is never left staring at a dead black VT. OnFailure
# fires only on terminal failure — not on the normal Restart= retries or the
# daily RuntimeMaxSec recycle — so it doesn't fight Conflicts= during a transient
# restart. This is the deterministic backstop to the getty enable in install.sh.
OnFailure=getty@tty1.service

[Service]
# Runs as the dedicated kiosk user. Cage opens DRM/KMS directly via the seat,
# so the user must be in the 'video', 'render', 'input' groups and have a seat
# (provided by seatd). install.sh sets all of this up.
User=picokiosk
Group=picokiosk
SupplementaryGroups=video render input seat
# DietPi often has a broken or missing systemd-logind (dbus-org.freedesktop.login1).
# Rely entirely on seatd for device management and explicitly tell wlroots which
# VT it is on so seatd can correctly route hotplugged devices (mice/keyboards).
Environment=XDG_VTNR=1

# The picokiosk system user has no logind session, so /run/user/<uid> is never
# created. Have systemd make a private runtime dir (0700, owned by the user) each
# start and point XDG_RUNTIME_DIR at it — without this, Cage fails to create its
# wl_display and dies immediately.
RuntimeDirectory=picogallery-kiosk
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/picogallery-kiosk
Environment=PICO_KIOSK_ENV=/etc/picogallery/kiosk.env
# seatd-managed seat access for the wlroots backend Cage uses.
# WLR_BACKENDS must include libinput alongside drm — "drm" alone renders video
# fine but silently disables all keyboard/mouse input (no libinput backend
# started), leaving the frame up with a dead keyboard/mouse.
Environment=WLR_BACKENDS=drm,libinput
# Force the seatd libseat backend. The correct variable is LIBSEAT_BACKEND
# (libseat reads it directly) — WLR_LIBSEAT_BACKEND is not a real variable and is
# a silent no-op. On DietPi logind (dbus-org.freedesktop.login1) is broken, so if
# libseat is left to auto-probe it can land on the dead logind backend and wlroots
# then opens zero input devices — dead keyboard AND mouse at the compositor.
Environment=LIBSEAT_BACKEND=seatd

ExecStart=/usr/local/bin/picogallery-kiosk
Restart=always
RestartSec=3
# Give the GPU/seat a moment on cold boot before the first attempt.
TimeoutStartSec=30
# Recycle the WebKit process daily. WPE's web process RSS creeps over days on a
# 24/7 frame and a page reload can't reclaim it — only restarting Cog does.
# Restart=always brings it back (a few-second black flash; the launcher's
# /health wait makes reconnect immediate since the server stays up).
RuntimeMaxSec=86400

[Install]
WantedBy=multi-user.target
